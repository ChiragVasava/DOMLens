{
  "manifest_version": 3,
  "name": "DOMLens",
  "version": "1.0.0",
  "description": "Visual HTML element inspector, DOM analyzer, and DevTools assistant.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-inspect-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+I",
        "mac": "Command+Shift+I"
      },
      "description": "Toggle Element Inspect Mode"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "utils/*.js",
        "content/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
